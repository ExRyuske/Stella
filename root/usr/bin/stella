#!/usr/bin/ucode -S
// stella — управление подписками и генерация конфига xray.

'use strict';

import { cursor } from 'uci';
import { readfile, writefile, rename, unlink, glob, popen, stat } from 'fs';
import { parse } from 'stella.uri';
import { decode } from 'stella.subscription';
import { build_config, outbound } from 'stella.xray';
import { fnv1a } from 'stella.util';
import { nft_script, dnsmasq_conf, restore_script, FW_MARK, ROUTE_TABLE, NFQWS_DESYNC_MARK } from 'stella.firewall';
import { parse_list } from 'stella.lists';
import { flowseal_strategy, zms_strategies, block_strategies, strategy_text, compose, zms_discord, zms_game_ports, game_strategies, localize, missing_files, test_list, HOSTLISTS } from 'stella.zapret';
import { CACHE_DIR, RUN_DIR, LISTS_DIR, STAB_PATH, read_json, stab_entry, stab_better, best_node, sub_label, load_nodes as store_load_nodes, load_lists, load_devices, task_busy, task_script } from 'stella.store';

const DEFAULT_UA = 'v2rayN/7.0';
const PING_URL = 'https://www.gstatic.com/generate_204';
const PING_PORT = 21000;
const PING_CHUNK = 50;
const PICK_ROUNDS = 5;
const TPROXY_PORT = 10812;
const DNS_PORT = 10853;
const CONF_DIR = '/var/etc/stella';
const ZAPRET_QNUM = 202;
const ZAPRET_BIN = '/opt/zapret/nfq/nfqws';
const ZAPRET_DIR = getenv('STELLA_ZAPRET_DIR') || '/etc/stella/zapret';
const ZMS_RAW = 'https://raw.githubusercontent.com/StressOzz/Zapret-Manager/main';
const FLOWSEAL_TGZ = 'https://codeload.github.com/Flowseal/zapret-discord-youtube/tar.gz/refs/heads/main';
const DPI_SUITE = 'https://raw.githubusercontent.com/hyperion-cs/dpi-checkers/main/ru/tcp-16-20/suite.v2.json';
// Автоподбор: своя очередь и диапазон исходящих портов ниже эфемерного (32768+) —
// в очередь теста попадает только его собственный трафик.
const ZT_QNUM = 205;
const ZT_PORTS = '20000-20999';
const ZT_PARALLEL = 4;
const YT_TARGETS = [ 'www.youtube.com', 'i.ytimg.com', 'yt3.ggpht.com', 'redirector.googlevideo.com', 'youtubei.googleapis.com', 'play.google.com' ];

const uci = cursor();

function opt(sec, name, def) {
	return uci.get('stella', sec, name) ?? def;
}

function shq(s) {
	return "'" + replace(s, "'", "'\\''") + "'";
}

// Записать настройки main и применить. reload перезапустит xray, только если изменился его
// конфиг; отвязанно — иначе reload из службы мог бы остановить и этот процесс.
function set_main(values) {
	for (let k, v in values)
		uci.set('stella', 'main', k, v);
	uci.commit('stella');
	if (opt('main', 'enabled', '0') == '1')
		system('setsid /etc/init.d/stella reload </dev/null >/dev/null 2>&1 &');
}

function usage() {
	warn('Использование: stella <команда>\n' +
		'  update [подписка]  обновить подписки\n' +
		'  nodes              список узлов (* — выбранный)\n' +
		'  gen [файл|-]       сгенерировать конфиг xray\n' +
		'  ping [id ...]      проверить задержку узлов (все, если id не заданы)\n' +
		'  pick [--apply]     подобрать лучший узел по задержке и стабильности\n' +
		'  fw up|down|show    включить/снять перехват трафика LAN, показать правила\n' +
		'  lists [id]         обновить списки сайтов\n' +
		'  upgrade check|stella|xray|zapret|dnsmasq  проверить или установить обновления\n' +
		'  migrate            переименовать анонимные секции в постоянные\n' +
		'  parse <ссылка>     разобрать ссылку\n');
	return 2;
}

// Уникальное имя временного файла: скачивания из разных процессов (обновление подписок,
// списков, каталога) могут совпасть по времени.
let fetch_seq = 0;

function fetch(url, ua, proxy) {
	let tmp = `/tmp/stella-fetch.${time()}.${fnv1a(url)}.${fetch_seq++}`;
	let cmd = sprintf('curl -fsSL --connect-timeout 10 --max-time 60 --retry 2 -A %s %s-o %s %s',
		shq(ua), proxy ? `--socks5-hostname ${shq(proxy)} ` : '', shq(tmp), shq(url));
	let rc = system(cmd);
	let body = (rc == 0) ? readfile(tmp) : null;
	unlink(tmp);
	return body;
}

// Обновление подписок. При неудаче остаётся прежний список (последний удачный).
function cmd_update(only) {
	let failed = 0;
	let proxy = `127.0.0.1:${opt('main', 'socks_port', '10808')}`;

	system(`mkdir -p ${shq(CACHE_DIR)}`);

	uci.foreach('stella', 'subscription', (s) => {
		if ((only && s['.name'] != only) || s.enabled == '0' || !s.url)
			return;

		let ua = s.user_agent || DEFAULT_UA;
		let body = fetch(s.url, ua, null);
		if (body == null) {
			warn(`${sub_label(s)}: напрямую недоступна, пробую через прокси\n`);
			body = fetch(s.url, ua, proxy);
		}
		if (body == null) {
			warn(`${sub_label(s)}: не удалось скачать, оставляю прежний список\n`);
			failed++;
			return;
		}

		let res = decode(body, s['.name']);
		for (let e in res.errors)
			warn(`${sub_label(s)}: пропущено "${e.line}": ${e.error}\n`);
		if (!length(res.nodes)) {
			warn(`${sub_label(s)}: не найдено ни одного узла, оставляю прежний список\n`);
			failed++;
			return;
		}

		// Панели (например, Remnawave) при каждом запросе выдают случайный shortId из
		// разрешённых. Если кроме него узел не изменился, оставляем прежний — иначе каждое
		// обновление перезапускало бы xray и писало на флеш.
		let path = `${CACHE_DIR}/${s['.name']}.json`;
		let old = {};
		for (let n in read_json(path, []))
			old[n.id] = n;
		for (let n in res.nodes) {
			let o = old[n.id];
			if (o && o.sid != n.sid && sprintf('%J', { ...n, sid: o.sid }) == sprintf('%J', o))
				n.sid = o.sid;
		}

		// Пишем на флеш только при изменениях.
		let data = sprintf('%J', res.nodes);
		if (readfile(path) != data) {
			writefile(`${path}.tmp`, data);
			rename(`${path}.tmp`, path);
		}
		print(`${sub_label(s)}: узлов ${length(res.nodes)}, пропущено ${length(res.errors)}\n`);
	});

	// Кэш удалённых подписок.
	let known = {};
	uci.foreach('stella', 'subscription', (s) => { known[`${CACHE_DIR}/${s['.name']}.json`] = true; });
	for (let f in glob(`${CACHE_DIR}/*.json`) || [])
		if (!known[f])
			unlink(f);

	return failed ? 1 : 0;
}

function load_nodes() {
	let errors = [];
	let nodes = store_load_nodes(uci, errors);
	for (let e in errors)
		warn(`узел ${e.name}: ${e.error}\n`);
	return nodes;
}

function cmd_nodes() {
	let sel = opt('main', 'node');
	for (let n in load_nodes())
		printf('%s %-24s %-11s %-16s %s\n', (n.id == sel) ? '*' : ' ',
			n.id, n.protocol, substr(n.source, 0, 16), n.name);
	return 0;
}

function lan_ifnames() {
	let v = opt('main', 'lan_ifname', ['br-lan']);
	return (type(v) == 'array') ? v : split(v, /[ ,]+/);
}

function dnsmasq_confs() {
	return map(glob('/tmp/dnsmasq*.d') || [], (d) => `${d}/stella.conf`);
}

function fw_down() {
	system('nft delete table inet stella 2>/dev/null');
	system(sprintf('while ip rule del fwmark 0x%x/0x%x table %d 2>/dev/null; do :; done', FW_MARK, FW_MARK, ROUTE_TABLE));
	system(`ip route flush table ${ROUTE_TABLE} 2>/dev/null`);

	let changed = false;
	for (let f in dnsmasq_confs())
		if (readfile(f) != null) {
			unlink(f);
			changed = true;
		}
	if (changed)
		system('/etc/init.d/dnsmasq restart >/dev/null 2>&1');
	return 0;
}

function enabled_lists() {
	return filter(load_lists(uci), (l) => l.enabled);
}

// Используется ли действие zapret хоть где-то — тогда нужен nfqws и очередь.
function zapret_used(lists) {
	if (opt('main', 'default_action', 'vpn') == 'zapret')
		return true;
	for (let l in lists)
		if (l.action == 'zapret')
			return true;
	return false;
}

function strategy_lines(text) {
	let res = [];
	for (let line in split(text || '', /\r?\n/)) {
		line = trim(line);
		if (line != '' && substr(line, 0, 1) != '#')
			push(res, ...filter(split(line, /[ \t]+/), (a) => a != ''));
	}
	return res;
}

// Пути к файлам пакета zapret → свои копии хостлистов, если они есть.
function zapret_paths() {
	let res = {};
	for (let name, h in HOSTLISTS) {
		let own = `${ZAPRET_DIR}/hosts-${name}.txt`;
		if (stat(own)?.size > 0)
			res[h.pkg] = own;
		else if (h.fallback)
			res[h.pkg] = h.fallback;
	}
	return res;
}

// nfqws сбрасывает права root и читает хостлисты уже после этого: файлы должны читаться
// всеми, а в /etc/stella — входить (прежние версии создавали их только для root).
function zapret_readable() {
	system(`chmod a+x ${shq(replace(ZAPRET_DIR, /\/[^\/]+\/?$/, '') || '/')} 2>/dev/null; chmod -R a+rX ${shq(ZAPRET_DIR)} 2>/dev/null`);
}

// Исключения Zapret: выбранные в настройках (zms, fs, all), иначе — по основной стратегии
// (у Flowseal свои, у остальных — список Zapret Manager).
function zapret_exclude_names() {
	let v = opt('main', 'zapret_exclude', '');
	if (v == 'all')
		return [ 'exclude', 'exclude_fs' ];
	if (v in [ 'zms', 'fs' ])
		return [ (v == 'fs') ? 'exclude_fs' : 'exclude' ];
	return [ index(opt('main', 'zapret_opts', ''), HOSTLISTS.exclude_fs.pkg) >= 0 ? 'exclude_fs' : 'exclude' ];
}

// Файлы выбранных исключений: своя копия, иначе файл пакета zapret.
function zapret_exclude_files() {
	let res = [];
	for (let n in zapret_exclude_names()) {
		let own = `${ZAPRET_DIR}/hosts-${n}.txt`;
		let f = (stat(own)?.size > 0) ? own : HOSTLISTS.exclude.pkg;
		if (!(f in res))
			push(res, f);
	}
	return res;
}

// Пути хостлистов → свои копии; при выбранных исключениях заложенные в стратегию
// --hostlist-exclude заменяются ими (nfqws принимает этот ключ несколько раз).
function zapret_localize(args) {
	if (opt('main', 'zapret_exclude', '') != '') {
		let own = map([ HOSTLISTS.exclude.pkg, HOSTLISTS.exclude_fs.pkg ], (f) => `--hostlist-exclude=${f}`);
		let excl = map(zapret_exclude_files(), (f) => `--hostlist-exclude=${f}`);
		let out = [];
		for (let a in args)
			if (a in own)
				push(out, ...excl);
			else
				push(out, a);
		args = out;
	}
	return localize(args, zapret_paths());
}

// Итоговая стратегия: YouTube (Yv) + основная (из каталога или своя) + Discord (Dv) + игры (Gv).
// Наборы выбираются по имени; старое «1» — первый вариант набора, «0»/пусто — выключено.
function zapret_parts() {
	let cat = read_json(`${ZAPRET_DIR}/catalog.json`, []);
	let pick = (key, family) => {
		let v = opt('main', key, '');
		if (v == '' || v == '0')
			return null;
		for (let st in cat)
			if (st.family == family && (st.name == v || v == '1'))
				return st;
		return null;
	};
	let z = compose({
		main: strategy_lines(opt('main', 'zapret_opts', '')),
		yt: pick('zapret_yt', 'yv'),
		discord: pick('zapret_discord', 'dv'),
		games: pick('zapret_games', 'gv'),
		games_fake: opt('main', 'zapret_games_fake', null),
		discord_fake: opt('main', 'zapret_discord_fake', null),
		tcp_ports: opt('main', 'zapret_tcp_ports', '80,443'),
		udp_ports: opt('main', 'zapret_udp_ports', '443')
	});
	z.args = zapret_localize(z.args);
	return z;
}

function zapret_ports() {
	let z = zapret_parts();
	return { tcp_ports: z.tcp_ports, udp_ports: z.udp_ports };
}

// Домены выбранных исключений Zapret, без повторов.
function zapret_exclude_domains() {
	let res = {};
	for (let f in zapret_exclude_files())
		for (let d in parse_list(readfile(f) || '').domains)
			res[d] = true;
	return keys(res);
}

function routing_opts() {
	let lists = enabled_lists();
	let zapret = zapret_used(lists);
	let hijack = opt('main', 'dns_hijack', '1') == '1';
	let block_doh = hijack && opt('main', 'block_doh', '1') == '1';
	return {
		lists,
		nft: {
			lan_ifnames: lan_ifnames(),
			tproxy_port: TPROXY_PORT,
			default_action: opt('main', 'default_action', 'vpn'),
			dns_hijack: hijack,
			block_doh,
			lists: map(lists, (l) => ({ id: l.id, action: l.action, cidrs: l.cidrs, devices_mode: l.devices_mode, macs: l.macs })),
			devices: load_devices(uci),
			zapret: zapret ? { qnum: ZAPRET_QNUM, ...zapret_ports() } : null
		},
		dnsmasq: { dns_port: DNS_PORT, block_doh, lists: [
			...map(lists, (l) => ({ id: l.id, domains: l.domains })),
			...(zapret ? [ { id: 'zapret_excl', domains: zapret_exclude_domains() } ] : [])
		] }
	};
}

// Одиночные IP из сетов списков текущей таблицы (подсети из конфига и так вернутся).
function saved_set_ips() {
	let p = popen('nft -j list table inet stella 2>/dev/null', 'r');
	let j = p ? json(p.read('all') || 'null') : null;
	p?.close();
	let res = {};
	for (let o in j?.nftables || [])
		if (o.set && match(o.set.name, /^(list_|zapret_excl$)/))
			res[o.set.name] = filter(o.set.elem || [], (e) => type(e) == 'string' && match(e, /^[0-9.]+$/));
	return res;
}

// Идемпотентно: повторный вызов пересоздаёт таблицу и не плодит ip rule.
function fw_up() {
	let o = routing_opts();
	system(`mkdir -p ${CONF_DIR}`);

	// IP, которые dnsmasq уже положил в сеты: таблица пересоздаётся, а устройства
	// не спросят DNS повторно, пока не истечёт их кэш — без этого сайты временно
	// шли бы не по тому правилу.
	let saved = saved_set_ips();

	let nft = `${CONF_DIR}/fw.nft`;
	writefile(nft, nft_script(o.nft));
	if (system(`nft -f ${nft}`) != 0) {
		warn('nft не принял правила, перехват не включён\n');
		fw_down();
		return 1;
	}

	// Содержимое сетов запоминается: в следующий раз адреса не вернутся в сет списка, из
	// которого что-то убрали.
	let cur = {};
	for (let l in o.dnsmasq.lists)
		cur[l.id] = l.domains;
	for (let l in o.lists)
		cur[l.id] = [ ...cur[l.id], ...l.cidrs ];
	let state = `${CONF_DIR}/fw-sets.json`;
	let restore = restore_script(saved, read_json(state, {}), cur);
	writefile(state, sprintf('%J', cur));
	if (length(restore)) {
		writefile(`${CONF_DIR}/fw-restore.nft`, join('\n', restore) + '\n');
		system(`nft -f ${CONF_DIR}/fw-restore.nft 2>/dev/null`);
	}

	system(sprintf('while ip rule del fwmark 0x%x/0x%x table %d 2>/dev/null; do :; done', FW_MARK, FW_MARK, ROUTE_TABLE));
	// Без этого маршрута перехваченный трафик VPN никуда не уходит — молчать нельзя.
	// (ip из busybox не принимает таблицы больше 255, поэтому в зависимостях ip-full.)
	if (system(sprintf('ip rule add fwmark 0x%x/0x%x table %d priority %d', FW_MARK, FW_MARK, ROUTE_TABLE, ROUTE_TABLE)) != 0 ||
	    system(`ip route replace local 0.0.0.0/0 dev lo table ${ROUTE_TABLE}`) != 0)
		warn('не удалось добавить маршрут для VPN (нужен пакет ip-full) — трафик списков VPN не пойдёт\n');

	let conf = dnsmasq_conf(o.dnsmasq);
	let changed = false;
	for (let f in dnsmasq_confs())
		if (readfile(f) != conf) {
			writefile(f, conf);
			changed = true;
		}
	if (changed)
		system('/etc/init.d/dnsmasq restart >/dev/null 2>&1');

	// Сайты, добавленные вручную, резолвим сразу: их IP попадут в сеты ещё до того,
	// как устройство спросит — меньше шансов, что первый заход пойдёт мимо правила.
	let manual = [];
	for (let l in o.lists)
		for (let e in parse_list(join('\n', l.entries)).domains)
			if (length(manual) < 300)
				push(manual, e);
	if (length(manual))
		system(`( for d in ${join(' ', manual)}; do nslookup $d 127.0.0.1 >/dev/null 2>&1; done ) </dev/null >/dev/null 2>&1 &`);
	return 0;
}

// Обновление списков по URL. Неудача — остаётся прежнее содержимое.
function cmd_lists(only) {
	let failed = 0;
	let proxy = `127.0.0.1:${opt('main', 'socks_port', '10808')}`;
	system(`mkdir -p ${shq(LISTS_DIR)}`);

	uci.foreach('stella', 'list', (s) => {
		let urls = (type(s.url) == 'array') ? s.url : (s.url ? [ s.url ] : []);
		if ((only && s['.name'] != only) || !length(urls))
			return;

		let text = [];
		for (let u in urls) {
			let body = fetch(u, 'stella', null) ?? fetch(u, 'stella', proxy);
			if (body == null) {
				warn(`${s.name}: не удалось скачать ${u}\n`);
				failed++;
				return;
			}
			push(text, body);
		}

		let res = parse_list(join('\n', text));
		if (!length(res.domains) && !length(res.cidrs)) {
			warn(`${s.name}: список пуст, оставляю прежний\n`);
			failed++;
			return;
		}
		let path = `${LISTS_DIR}/${s['.name']}.json`;
		let data = sprintf('%J', res);
		if (readfile(path) != data) {
			writefile(`${path}.tmp`, data);
			rename(`${path}.tmp`, path);
		}
		print(`${s.name}: доменов ${length(res.domains)}, подсетей ${length(res.cidrs)}\n`);
	});

	let known = {};
	uci.foreach('stella', 'list', (s) => { known[`${LISTS_DIR}/${s['.name']}.json`] = true; });
	for (let f in glob(`${LISTS_DIR}/*.json`) || [])
		if (!known[f])
			unlink(f);

	return failed ? 1 : 0;
}

// Команда запуска nfqws для init (по строке на аргумент); пусто — zapret не используется.
function cmd_zapret_cmd() {
	if (!zapret_used(enabled_lists()))
		return 1;
	let z = zapret_parts();
	if (!length(z.args))
		return 1;
	// Без нужного файла nfqws не стартует и молча перезапускается procd по кругу — лучше не
	// запускать вовсе и показать в интерфейсе, чего не хватает.
	let bin = opt('main', 'zapret_bin', ZAPRET_BIN);
	let missing = missing_files(z.args, (f) => stat(f) != null);
	if (!stat(bin))
		unshift(missing, bin);
	system(`mkdir -p ${RUN_DIR}`);
	zapret_readable();
	if (length(missing)) {
		writefile(`${RUN_DIR}/zapret-missing.json`, sprintf('%J', missing));
		warn(`nfqws не запущен: нет файлов ${join(', ', missing)}\n`);
		return 1;
	}
	unlink(`${RUN_DIR}/zapret-missing.json`);
	let args = [ bin, `--qnum=${ZAPRET_QNUM}`, sprintf('--dpi-desync-fwmark=0x%x', NFQWS_DESYNC_MARK), ...z.args ];
	print(join('\n', args), '\n');
	return 0;
}

function cmd_fw(action) {
	if (action == 'up')
		return fw_up();
	if (action == 'down')
		return fw_down();
	if (action == 'show') {
		let o = routing_opts();
		print(nft_script(o.nft), '\n', dnsmasq_conf(o.dnsmasq));
		return 0;
	}
	return usage();
}

const AUTO_MAX = 30;

// Конфиг xray для текущих настроек; 'stop' — выбранный узел пропал, а замены нет.
function current_config() {
	let nodes = load_nodes();
	let by_id = {};
	for (let n in nodes)
		by_id[n.id] = n;

	let auto_nodes = [], starred = [];
	let ids = opt('main', 'auto_node', []);
	for (let id in (type(ids) == 'array') ? ids : [ ids ])
		if (by_id[id])
			push(starred, by_id[id]);
	if (opt('main', 'select_mode', 'single') == 'auto')
		auto_nodes = slice(starred, 0, AUTO_MAX);

	let node_id = opt('main', 'node');
	let node = node_id ? by_id[node_id] : null;
	// Узел пропал (провайдер переименовал сервер, подписку выключили). В автовыборе запасным
	// станет первый из ★. Иначе — лучший из ★ по проверке, а без ★ — по настройке
	// node_missing: stop — Stella не запускается (работающая остаётся на прежнем конфиге),
	// best — лучший по проверке из всех.
	if (node_id && !node && length(auto_nodes) < 2) {
		let stab = read_json(STAB_PATH, {});
		node = best_node(starred, stab) || starred[0];
		if (!node && opt('main', 'node_missing', 'stop') == 'best')
			node = best_node(nodes, stab) || filter(nodes, (n) => index(node_id, `${n.source_id}_`) == 0)[0] || nodes[0];
		if (!node) {
			warn(`выбранный узел ${node_id} не найден\n`);
			return 'stop';
		}
		warn(`выбранный узел ${node_id} не найден, временно работаю через «${node.name}»\n`);
	}

	for (let n in [ node, ...auto_nodes ])
		for (let w in n?.warnings || [])
			warn(`${n.name}: ${w}\n`);

	return build_config({
		node,
		auto_nodes,
		log_level: opt('main', 'log_level', 'warning'),
		socks_port: +opt('main', 'socks_port', '10808'),
		intercept: true,
		tproxy_port: TPROXY_PORT,
		dns_port: DNS_PORT,
		dns_remote: opt('main', 'dns_remote', 'https://1.1.1.1/dns-query'),
		dns_direct: opt('main', 'dns_direct', 'https://77.88.8.8/dns-query')
	});
}

function cmd_gen(out) {
	let cfg = current_config();
	if (cfg == 'stop')
		return 3;

	let data = sprintf('%.J\n', cfg);
	if (!out || out == '-')
		print(data);
	else if (!writefile(out, data)) {
		warn(`не удалось записать ${out}\n`);
		return 1;
	}
	return 0;
}

// Реальная задержка: временный xray с отдельным socks-входом на каждый узел, через
// каждый параллельно идут rounds запросов к generate_204 подряд. Результат — медиана
// (мс, -1 — ни одного ответа, -2 — xray не принял конфиг); stab (если задан) получает
// итоги проверки стабильности.
function ping_chunk(nodes, results, rounds, stab) {
	let cfg_path = `${RUN_DIR}/ping.json.cfg.json`;
	let cfg = { log: { loglevel: 'none' }, inbounds: [], outbounds: [], routing: { rules: [] } };

	for (let i, n in nodes) {
		push(cfg.inbounds, { tag: `in${i}`, listen: '127.0.0.1', port: PING_PORT + i, protocol: 'socks' });
		push(cfg.outbounds, outbound(n, `out${i}`));
		push(cfg.routing.rules, { inboundTag: [ `in${i}` ], outboundTag: `out${i}` });
	}
	writefile(cfg_path, sprintf('%J', cfg));

	system(`xray run -c ${shq(cfg_path)} >/dev/null 2>&1 & echo $! > ${shq(RUN_DIR)}/ping.xray.pid`);
	let pid = trim(readfile(`${RUN_DIR}/ping.xray.pid`) || '');
	sleep(1000);

	if (system(`kill -0 ${pid} 2>/dev/null`) != 0) {
		// xray не принял конфиг целиком — помечаем пачку, но не останавливаемся.
		for (let n in nodes) {
			results[n.id] = -2;
			if (stab)
				stab[n.id] = { ok: 0, n: rounds, ms: -1, jit: 0, at: time() };
		}
		unlink(cfg_path);
		return;
	}

	let samples = map(nodes, () => []);
	for (let r = 0; r < rounds; r++) {
		let cmd = '';
		for (let i = 0; i < length(nodes); i++) {
			let port = PING_PORT + i;
			cmd += sprintf("curl -s -o /dev/null --max-time 6 -w '%%{http_code} %%{time_total}' --socks5-hostname 127.0.0.1:%d %s > %s/ping.%d 2>/dev/null & ",
				port, PING_URL, shq(RUN_DIR), port);
		}
		system(cmd + 'wait');
		for (let i = 0; i < length(nodes); i++) {
			let out = `${RUN_DIR}/ping.${PING_PORT + i}`;
			let m = match(readfile(out) || '', /^(200|204) ([0-9.]+)/);
			push(samples[i], m ? int(+m[2] * 1000) : -1);
			unlink(out);
		}
	}
	system(`kill ${pid} 2>/dev/null`);
	// Следующая пачка займёт те же порты — ждём, пока xray их освободит.
	for (let i = 0; i < 30 && system(`kill -0 ${pid} 2>/dev/null`) == 0; i++)
		sleep(100);

	for (let i, n in nodes) {
		let e = stab_entry(samples[i]);
		results[n.id] = e.ok ? e.ms : -1;
		if (stab)
			stab[n.id] = { ...e, at: time() };
	}
	unlink(cfg_path);
}

// Проверка пачками по PING_CHUNK; задержки — в $RUN_DIR/ping.json, итоги стабильности
// (если stab задан) — в STAB_PATH.
function measure(nodes, rounds, stab) {
	system(`mkdir -p ${shq(RUN_DIR)}`);
	let path = `${RUN_DIR}/ping.json`;
	let results = read_json(path, {});
	for (let i = 0; i < length(nodes); i += PING_CHUNK) {
		ping_chunk(slice(nodes, i, i + PING_CHUNK), results, rounds, stab);
		writefile(`${path}.tmp`, sprintf('%J', results));
		rename(`${path}.tmp`, path);
	}
	if (stab) {
		writefile(`${STAB_PATH}.tmp`, sprintf('%J', stab));
		rename(`${STAB_PATH}.tmp`, STAB_PATH);
	}
	return results;
}

function cmd_ping(...ids) {
	let nodes = load_nodes();
	if (length(ids))
		nodes = filter(nodes, (n) => n.id in ids);

	let results = measure(nodes, 1, null);
	for (let n in nodes)
		printf('%6s  %s\n', (results[n.id] >= 0) ? `${results[n.id]}ms` : 'fail', n.name);
	return 0;
}

// Режим «лучший по проверке»: через каждый узел из выбранных (best_from: пусто — все,
// иначе id подписки) по PICK_ROUNDS запросов; лучший — с наибольшей долей ответов, при
// равной — с меньшими задержкой и разбросом. Текущий меняется, только если новый заметно
// лучше. --apply — сохранить выбор (reload перезапустит xray, раз изменился конфиг).
function cmd_pick(...argv) {
	let all = load_nodes();
	let from = opt('main', 'best_from', '');
	let nodes = filter(all, (n) => from == '' || n.source_id == from);
	if (!length(nodes)) {
		warn('нет узлов для подбора\n');
		return 1;
	}
	// Итоги узлов, которых больше нет, не копим.
	let stab = read_json(STAB_PATH, {});
	let alive = {};
	for (let n in all)
		alive[n.id] = true;
	for (let id in keys(stab))
		if (!alive[id])
			delete stab[id];

	measure(nodes, PICK_ROUNDS, stab);
	let best = best_node(nodes, stab);
	if (!best) {
		warn('ни один узел не ответил — выбор не меняю\n');
		return 1;
	}
	let cur_id = opt('main', 'node', '');
	let cur = filter(nodes, (n) => n.id == cur_id)[0];
	if (best.id == cur_id || (cur && !stab_better(stab[best.id], stab[cur_id]))) {
		printf('Текущий узел не хуже лучшего: %s\n', cur.name);
		return 0;
	}
	let e = stab[best.id];
	printf('Лучший узел: %s — ответил %d из %d, %d мс ±%d\n', best.name, e.ok, e.n, e.ms, e.jit);
	if ('--apply' in argv)
		set_main({ node: best.id });
	return 0;
}

// Анонимные секции (cfgXXXX, например после ручного `uci add`) переименовываются
// в постоянные: иначе их имя меняется при удалении соседних секций, а вместе с ним
// id узлов, файл кэша и выбранный узел.
function cmd_migrate() {
	let renames = [];
	for (let t in [ [ 'subscription', 'sub', 'url' ], [ 'node', 'node', 'link' ] ])
		uci.foreach('stella', t[0], (s) => {
			if (s['.anonymous'])
				push(renames, [ s['.name'], `${t[1]}_${fnv1a(s[t[2]] || s['.name'])}` ]);
		});
	if (!length(renames))
		return 0;

	let sel = opt('main', 'node');
	for (let r in renames) {
		let from = r[0], to = r[1];
		while (uci.get('stella', to))
			to += 'x';
		uci.rename('stella', from, to);
		r[1] = to;

		let cache = read_json(`${CACHE_DIR}/${from}.json`, null);
		if (cache) {
			for (let n in cache)
				n.id = to + substr(n.id, length(from));
			writefile(`${CACHE_DIR}/${to}.json`, sprintf('%J', cache));
			unlink(`${CACHE_DIR}/${from}.json`);
		}
		if (sel == from || index(sel, `${from}_`) == 0)
			uci.set('stella', 'main', 'node', to + substr(sel, length(from)));
		print(`${from} -> ${to}\n`);
	}
	// Отметки автовыбора — те же id узлов.
	let auto = opt('main', 'auto_node', null);
	if (auto != null)
		uci.set('stella', 'main', 'auto_node', map((type(auto) == 'array') ? auto : [ auto ], (id) => {
			for (let r in renames)
				if (id == r[0] || index(id, `${r[0]}_`) == 0)
					return r[1] + substr(id, length(r[0]));
			return id;
		}));
	uci.commit('stella');
	return 0;
}

/* ---- Zapret: каталог стратегий, автоподбор, применение ---- */

function fetch_any(url, proxy) {
	return fetch(url, 'Mozilla/5.0', null) ?? fetch(url, 'Mozilla/5.0', proxy);
}

// Каталог из трёх источников. Не скачался источник — остаётся его часть из прежнего
// каталога: обеднять рабочий каталог из-за сбоя сети незачем.
function cmd_zapret_catalog() {
	let proxy = `127.0.0.1:${opt('main', 'socks_port', '10808')}`;
	let old = read_json(`${ZAPRET_DIR}/catalog.json`, []);
	let keep = (family) => filter(old, (s) => s.family == family);
	system(`mkdir -p ${shq(ZAPRET_DIR)}/fake`);

	let zms = fetch_any(`${ZMS_RAW}/Zapret-Manager.sh`, proxy);
	let v = zms_strategies(zms);
	if (!length(v)) { warn('ZMS: стратегии v не получены, оставляю прежние\n'); v = keep('v'); }
	let dv = zms_discord(zms);
	if (!length(dv)) dv = keep('dv');
	let gv = game_strategies(zms_game_ports(zms));

	let yv = block_strategies(fetch_any(`${ZMS_RAW}/files/StrYoutube`, proxy), 'yv');
	if (!length(yv)) { warn('ZMS: стратегии YouTube не получены, оставляю прежние\n'); yv = keep('yv'); }

	let fs = [];
	let tgz = '/tmp/stella-flowseal.tgz', dir = '/tmp/stella-flowseal';
	let body = fetch_any(FLOWSEAL_TGZ, proxy);
	if (body != null && writefile(tgz, body) &&
	    system(`rm -rf ${dir} && mkdir -p ${dir} && tar -xzf ${tgz} -C ${dir} 2>/dev/null`) == 0) {
		for (let f in glob(`${dir}/*/bin/*.bin`) || [])
			system(`cp -f ${shq(f)} ${shq(ZAPRET_DIR)}/fake/`);
		for (let f in sort(glob(`${dir}/*/general*.bat`) || [])) {
			let name = replace(replace(f, /^.*\//, ''), /\.bat$/, '');
			let st = flowseal_strategy(readfile(f), name, `${ZAPRET_DIR}/fake`);
			if (st)
				push(fs, st);
		}
	}
	system(`rm -rf ${dir} ${tgz}`);
	if (!length(fs)) { warn('Flowseal: стратегии не получены, оставляю прежние\n'); fs = keep('fs'); }

	// Свои копии хостлистов (YouTube/Google и исключения). Не скачался — остаётся прежний.
	for (let name, h in HOSTLISTS) {
		let body = fetch_any(h.url, proxy);
		let lines = filter(map(split(body || '', /\r?\n/), (l) => trim(l)), (l) => l != '' && substr(l, 0, 1) != '#');
		if (length(lines) < 10) {
			warn(`хостлист ${name}: не получен, оставляю прежний\n`);
			continue;
		}
		for (let d in h.extra)
			if (!(d in lines))
				push(lines, d);
		let path = `${ZAPRET_DIR}/hosts-${name}.txt`, data = join('\n', lines) + '\n';
		if (readfile(path) != data)
			writefile(path, data);
	}

	// Набор целей для проверки — тоже с сети, с запасным встроенным.
	let suite = fetch_any(DPI_SUITE, proxy);
	if (suite && type(json(suite)) == 'array')
		writefile(`${ZAPRET_DIR}/suite.json`, suite);

	zapret_readable();

	let all = [ ...v, ...yv, ...fs, ...dv, ...gv ];
	let data = sprintf('%J', all);
	if (length(all) && readfile(`${ZAPRET_DIR}/catalog.json`) != data)
		writefile(`${ZAPRET_DIR}/catalog.json`, data);
	writefile(`${ZAPRET_DIR}/catalog.updated`, `${time()}`);
	printf('Каталог: v %d, YouTube %d, Flowseal %d, Discord %d, игры %d\n', length(v), length(yv), length(fs), length(dv), length(gv));
	return length(all) ? 0 : 1;
}

function zapret_catalog() {
	return read_json(`${ZAPRET_DIR}/catalog.json`, []);
}

// Цели проверки: для YouTube-стратегий — домены YouTube, для остальных — хосты за
// зарубежными CDN (набор dpi-checkers: обрыв на 16–20 КБ) плюс YouTube.
function zt_targets(family) {
	if (family == 'yv')
		return YT_TARGETS;
	let suite = read_json(`${ZAPRET_DIR}/suite.json`, null);
	let hosts = [];
	// Хост идёт в командную строку, а файл скачан из чужого репозитория — только имя хоста.
	for (let s in (type(suite) == 'array') ? suite : [])
		if (type(s.host) == 'string' && match(s.host, /^[A-Za-z0-9.-]+$/) && !match(s.id || '', /GH-HPRN/) && length(hosts) < 12)
			push(hosts, s.host);
	if (!length(hosts))
		hosts = [ 'cdn.apple-mapkit.com', 'amplifon.com', 'cdn.eso.org', 'go.coveo.com' ];
	return [ ...hosts, 'www.youtube.com', 'i.ytimg.com' ];
}

// Сколько целей открылось: успех — ответ получен целиком или скачано больше 24 КБ
// (обрыв DPI случается на 16–20 КБ).
function zt_probe(hosts) {
	let cmd = '';
	for (let i, h in hosts) {
		cmd += sprintf("(curl -s -o /dev/null --local-port %s --connect-timeout 3 --max-time 6 -r 0-65535 -w '%%{size_download}' https://%s/ >%s/zt.%d 2>/dev/null; echo \" $?\" >>%s/zt.%d) & ",
			ZT_PORTS, h, RUN_DIR, i, RUN_DIR, i);
		if ((i + 1) % ZT_PARALLEL == 0)
			cmd += 'wait; ';
	}
	system(cmd + 'wait');
	let ok = [];
	for (let i, h in hosts) {
		let m = match(readfile(`${RUN_DIR}/zt.${i}`) || '', /^([0-9]+) +([0-9]+)/);
		unlink(`${RUN_DIR}/zt.${i}`);
		if (m && (+m[2] == 0 || +m[1] >= 24576))
			push(ok, h);
	}
	return ok;
}

function zt_nft(on) {
	if (!on)
		return system('nft delete table inet stella_ztest 2>/dev/null');
	let script = join('\n', [
		'table inet stella_ztest',
		'delete table inet stella_ztest',
		'table inet stella_ztest {',
		'	chain out {',
		'		type filter hook output priority mangle; policy accept;',
		sprintf('		meta mark & 0x%x != 0 return', NFQWS_DESYNC_MARK),
		`		tcp sport ${ZT_PORTS} ct original packets 1-9 queue flags bypass to ${ZT_QNUM}`,
		`		udp sport ${ZT_PORTS} ct original packets 1-9 queue flags bypass to ${ZT_QNUM}`,
		'	}',
		'	chain in {',
		'		type filter hook prerouting priority filter; policy accept;',
		`		tcp dport ${ZT_PORTS} ct reply packets 1-3 queue flags bypass to ${ZT_QNUM}`,
		'	}',
		'}', ''
	]);
	writefile(`${RUN_DIR}/ztest.nft`, script);
	return system(`nft -f ${RUN_DIR}/ztest.nft`);
}

// Открытые цели или { error: почему nfqws не запустился }.
function zt_run(bin, args, hosts) {
	args = zapret_localize(args);
	let missing = missing_files(args, (f) => stat(f) != null);
	if (length(missing))
		return { error: `нет файлов: ${join(', ', missing)}` };
	let all = [ `--qnum=${ZT_QNUM}`, sprintf('--dpi-desync-fwmark=0x%x', NFQWS_DESYNC_MARK), ...args ];
	let log = `${RUN_DIR}/ztest.nfqws.log`;
	system(`${shq(bin)} ${join(' ', map(all, shq))} >${log} 2>&1 & echo $! >${RUN_DIR}/ztest.nfqws.pid`);
	let pid = trim(readfile(`${RUN_DIR}/ztest.nfqws.pid`) || '');
	sleep(400);
	if (!pid || system(`kill -0 ${pid} 2>/dev/null`) != 0) {
		// Последняя строка вывода nfqws обычно и есть причина.
		let lines = filter(split(trim(readfile(log) || ''), '\n'), (l) => trim(l) != '');
		return { error: length(lines) ? `nfqws: ${trim(lines[length(lines) - 1])}` : 'nfqws не запустился' };
	}
	let ok = zt_probe(hosts);
	system(`kill ${pid} 2>/dev/null`);
	sleep(200);
	system(`kill -9 ${pid} 2>/dev/null`);
	return ok;
}

// Стратегия YouTube — в своё поле, остальные — основной.
function zapret_apply(st) {
	set_main((st.family == 'yv') ? { zapret_yt: st.name } : { zapret_strategy: st.name, zapret_opts: strategy_text(st) });
}

// Автоподбор: scope — all | main | v | yv | fs | имя стратегии; --apply — применить лучшую,
// если она открывает больше текущей и больше, чем без обхода (менять работающее на равное
// незачем); --scheduled — запуск по расписанию: выключенные категории он не включает.
function cmd_zapret_test(...argv) {
	let apply = ('--apply' in argv), scheduled = ('--scheduled' in argv);
	let scope = filter(argv, (a) => !(a in [ '--apply', '--scheduled' ]))[0] || 'all';
	let bin = opt('main', 'zapret_bin', ZAPRET_BIN);
	// Текущая стратегия проверяется наравне с каталогом — с ней и сравнивается лучшая.
	let cur_lines = map(split(opt('main', 'zapret_opts', ''), /\r?\n/), (l) => trim(l));
	let cur_args = filter(cur_lines, (l) => l != '' && substr(l, 0, 1) != '#');
	// Имя — из настроек, а у импортированной из zapret — из первой строки «#v7».
	let cur_name = opt('main', 'zapret_strategy', '') || match(cur_lines[0] || '', /^#(.+)$/)?.[1] || '';
	let list = test_list(zapret_catalog(), scope, { name: cur_name, args: cur_args });
	system(`mkdir -p ${RUN_DIR} ${shq(ZAPRET_DIR)}`);
	// Ход проверки для интерфейса; scope — у какой категории его показывать.
	let progress = `${RUN_DIR}/ztest.json`;
	writefile(progress, sprintf('%J', { state: 'running', done: 0, total: 0, scope }));
	// Без nfqws проверять нечего: каждая стратегия записалась бы «ошибкой».
	let fail = (msg) => {
		writefile(progress, sprintf('%J', { state: 'done', done: 0, total: 0, scope, message: msg }));
		warn(msg + '\n');
		return 1;
	};
	if (!length(list))
		return fail('нет стратегий для проверки — обновите каталог');
	if (!stat(bin))
		return fail(`nfqws не найден (${bin}) — установите zapret`);
	zapret_readable();

	let stopf = `${RUN_DIR}/ztest.stop`;
	unlink(stopf);
	let res_path = `${ZAPRET_DIR}/results.json`;
	let res = read_json(res_path, { items: {} });
	res.items ??= {};

	if (zt_nft(true) != 0)
		return fail('nft не принял правила проверки — нужен модуль ядра kmod-nft-queue');

	// Контроль без обхода — по каждому набору целей.
	let baseline = {};
	for (let fam in uniq(map(list, (s) => (s.family == 'yv') ? 'yv' : 'general'))) {
		let hosts = zt_targets(fam == 'yv' ? 'yv' : 'general');
		baseline[fam] = { ok: length(zt_probe(hosts)), total: length(hosts) };
	}
	// Проверка одной категории не стирает замер без обхода у другой.
	res.baseline = { ...(res.baseline || {}), ...baseline };

	for (let i, st in list) {
		if (readfile(stopf) != null)
			break;
		writefile(progress, sprintf('%J', { state: 'running', done: i, total: length(list), current: st.name, scope }));
		let fam = (st.family == 'yv') ? 'yv' : 'general';
		let hosts = zt_targets(fam);
		let ok = zt_run(bin, st.args, hosts);
		res.items[st.name] = (type(ok) == 'array')
			? { family: st.family, ok: length(ok), total: length(hosts), at: time() }
			: { family: st.family, ok: -1, total: length(hosts), at: time(), error: ok.error };
	}
	zt_nft(false);
	res.at = time();
	writefile(res_path, sprintf('%J', res));

	let msg = 'Проверка закончена';
	if (apply && readfile(stopf) == null) {
		let msgs = [];
		// Основная и YouTube выбираются раздельно: лучшая Yv идёт в поле YouTube, а не
		// в основную. Меняется, только если лучшая открывает больше текущей и больше, чем
		// без обхода. Выключенная категория — «текущей» нет; по расписанию её не включаем.
		let yt_cur = opt('main', 'zapret_yt', '');
		// Старое «1» — первый вариант набора, как в zapret_parts.
		if (yt_cur == '1')
			yt_cur = filter(zapret_catalog(), (s) => s.family == 'yv')[0]?.name || '';
		for (let yt in [ false, true ]) {
			let on = yt ? !(yt_cur in [ '', '0' ]) : length(cur_args) > 0;
			if (scheduled && !on)
				continue;
			let best = null;
			for (let st in list)
				if (st.family != 'current' && (st.family == 'yv') == yt && res.items[st.name]?.ok >= 0 &&
				    (!best || res.items[st.name].ok > res.items[best.name].ok))
					best = st;
			if (!best)
				continue;
			let cur = on ? (res.items[yt ? yt_cur : (cur_name || 'текущая')]?.ok ?? -1) : -1;
			let base = res.baseline?.[yt ? 'yv' : 'general']?.ok ?? -1;
			let got = res.items[best.name];
			if (got.ok > max(cur, base)) {
				zapret_apply(best);
				push(msgs, sprintf('%s: %s (%d из %d)', yt ? 'YouTube' : 'основная', best.name, got.ok, got.total));
			}
		}
		msg = length(msgs) ? 'Применена ' + join(', ', msgs) : 'Текущие стратегии не хуже лучших из проверенных — оставлены';
	}
	writefile(progress, sprintf('%J', { state: readfile(stopf) != null ? 'stopped' : 'done', done: length(list), total: length(list), scope, message: msg }));
	unlink(stopf);
	print(msg, '\n');
	return 0;
}

function cmd_zapret_apply(name) {
	for (let st in zapret_catalog())
		if (st.name == name) {
			zapret_apply(st);
			return 0;
		}
	warn(`стратегии «${name}» нет в каталоге\n`);
	return 1;
}

/* ---- обновления: сама Stella (релизы GitHub) и xray-core (репозиторий OpenWrt) ---- */

const REPO = 'ExRyuske/Stella';

function cmd_out(cmd) {
	let p = popen(cmd, 'r');
	let out = p ? p.read('all') : '';
	p?.close();
	return out || '';
}

function pkg_version(name, upgradable) {
	let m = match(cmd_out(`apk list ${upgradable ? '-u' : '-I'} ${name} 2>/dev/null`), regexp(`${name}-([0-9][^ ]*)`));
	return m ? m[1] : null;
}

// «0.1.2-r1» / «v0.1.2» → [0,1,2]; новее ли a, чем b.
function newer(a, b) {
	let va = map(split(match(a || '', /[0-9]+(\.[0-9]+)*/)?.[0] || '0', '.'), (x) => +x);
	let vb = map(split(match(b || '', /[0-9]+(\.[0-9]+)*/)?.[0] || '0', '.'), (x) => +x);
	for (let i = 0; i < max(length(va), length(vb)); i++)
		if ((va[i] ?? 0) != (vb[i] ?? 0))
			return (va[i] ?? 0) > (vb[i] ?? 0);
	return false;
}

// Последний релиз на GitHub; asset — регулярка имени нужного файла.
function github_release(repo, asset) {
	let proxy = `127.0.0.1:${opt('main', 'socks_port', '10808')}`;
	let r = json(fetch_any(`https://api.github.com/repos/${repo}/releases/latest`, proxy) || 'null');
	if (type(r) != 'object' || !r.tag_name)
		return null;
	let file = null;
	for (let a in r.assets || [])
		if (match(a.name || '', asset))
			file = a.browser_download_url;
	return { tag: r.tag_name, file, url: r.html_url, notes: r.body || '' };
}

function latest_release() {
	let r = github_release(REPO, /^luci-app-stella.*\.apk$/);
	if (r)
		r.apk = r.file;
	return r;
}

// Zapret — релизы remittor/zapret-openwrt: архив под архитектуру роутера с пакетами внутри.
const ZAPRET_REPO = 'remittor/zapret-openwrt';

function router_arch() {
	return match(readfile('/etc/openwrt_release') || '', /DISTRIB_ARCH='([^']+)'/)?.[1];
}

function zapret_release() {
	let arch = router_arch();
	return arch ? github_release(ZAPRET_REPO, regexp(`^zapret_v[0-9.]+_${replace(arch, /[.]/g, '\\.')}\\.zip$`)) : null;
}

// check — записать сведения в $RUN_DIR/update.json; stella / xray — обновить.
function cmd_upgrade(what) {
	system(`mkdir -p ${RUN_DIR}`);
	if (what == 'check' || !what) {
		system('apk update >/dev/null 2>&1');
		let rel = latest_release();
		let cur = pkg_version('luci-app-stella');
		let info = {
			at: time(),
			stella: {
				installed: cur,
				latest: rel?.tag,
				url: rel?.url,
				notes: rel?.notes,
				available: !!(rel && rel.apk && (!cur || newer(rel.tag, cur))),
				error: rel ? null : 'не удалось получить релизы с GitHub (нет сети или репозиторий закрыт)'
			},
			xray: { installed: pkg_version('xray-core'), latest: pkg_version('xray-core', true) }
		};
		info.xray.available = !!info.xray.latest;
		// Zapret: Stella берёт из пакета nfqws и подделки; не установлен — предложим поставить.
		let zcur = pkg_version('zapret');
		let zr = zapret_release();
		info.zapret = {
			installed: zcur,
			latest: zr ? replace(zr.tag, /^v/, '') : null,
			url: zr?.url,
			available: !!(zr && zr.file && (!zcur || newer(zr.tag, zcur))),
			error: zr ? null : 'не удалось получить релизы zapret с GitHub'
		};
		writefile(`${RUN_DIR}/update.json`, sprintf('%J', info));
		print(sprintf('%.J\n', info));
		return 0;
	}

	if (what == 'stella') {
		let rel = latest_release();
		if (!rel?.apk) {
			warn('в последнем релизе нет пакета\n');
			return 1;
		}
		let proxy = `127.0.0.1:${opt('main', 'socks_port', '10808')}`;
		let body = fetch_any(rel.apk, proxy);
		if (body == null || !writefile('/tmp/luci-app-stella.apk', body)) {
			warn('не удалось скачать пакет\n');
			return 1;
		}
		let rc = system('apk add --allow-untrusted /tmp/luci-app-stella.apk');
		unlink('/tmp/luci-app-stella.apk');
		if (rc != 0)
			return 1;
	}
	else if (what == 'xray') {
		if (system('apk update >/dev/null 2>&1; apk upgrade xray-core') != 0)
			return 1;
	}
	else if (what == 'dnsmasq') {
		// dnsmasq-full вместо dnsmasq: только в нём есть nftset. Всё скачивается заранее —
		// после удаления dnsmasq DNS на роутере нет, — а не встанет новый, возвращается старый.
		let d = '/tmp/stella-dnsmasq';
		// Перехват снимаем: пока он есть, DNS роутера идёт через xray, и скачивание зависит
		// от VPN. Вернёт его reload в конце.
		fw_down();
		if (system(`rm -rf ${d} && mkdir -p ${d}/old && apk update >/dev/null 2>&1 && ` +
		           `apk fetch -R -o ${d} dnsmasq-full && apk fetch -o ${d}/old dnsmasq`) != 0) {
			warn('не удалось скачать dnsmasq-full\n');
			system(`rm -rf ${d}; /etc/init.d/stella reload >/dev/null 2>&1`);
			return 1;
		}
		system(`cp /etc/config/dhcp ${d}/dhcp`);
		let rc = system(`apk del dnsmasq && apk add --allow-untrusted ${d}/*.apk`);
		if (rc != 0)
			system(`apk add --allow-untrusted ${d}/old/*.apk`);
		// Настройки DHCP и DNS — прежние, а не из нового пакета.
		system(`cp ${d}/dhcp /etc/config/dhcp; rm -f /etc/config/dhcp.apk-new; rm -rf ${d}; /etc/init.d/dnsmasq enable; /etc/init.d/dnsmasq restart`);
		if (rc != 0) {
			warn('dnsmasq-full не установился, возвращён прежний dnsmasq\n');
			system('/etc/init.d/stella reload >/dev/null 2>&1');
			return 1;
		}
	}
	else if (what == 'zapret') {
		let zr = zapret_release();
		if (!zr?.file) {
			warn('в последнем релизе zapret нет архива для этого роутера\n');
			return 1;
		}
		// Релиз — zip, а unzip в чистой прошивке нет: ставим его из репозитория OpenWrt.
		if (system('command -v unzip >/dev/null || { apk update >/dev/null 2>&1; apk add unzip; }') != 0) {
			warn('не удалось установить unzip — он нужен, чтобы распаковать архив zapret\n');
			return 1;
		}
		let proxy = `127.0.0.1:${opt('main', 'socks_port', '10808')}`;
		let body = fetch_any(zr.file, proxy);
		let dir = '/tmp/stella-zapret-upgrade';
		if (body == null || system(`rm -rf ${dir} && mkdir -p ${dir}`) != 0 || !writefile(`${dir}/zapret.zip`, body) ||
		    system(`unzip -oq ${dir}/zapret.zip -d ${dir}`) != 0) {
			warn('не удалось скачать или распаковать архив zapret\n');
			system(`rm -rf ${dir}`);
			return 1;
		}
		// Отдельная служба zapret мешает Zapret в Stella: если она была остановлена и
		// выключена, после обновления такой и остаётся (пакет может её запустить).
		let was_enabled = system('/etc/init.d/zapret enabled 2>/dev/null') == 0;
		let was_running = system('nft list table inet zapret >/dev/null 2>&1') == 0;
		// Только сам пакет zapret: luci-app-zapret не нужен, Zapret настраивает Stella.
		let pkgs = filter(split(trim(cmd_out(`find ${dir} -name '*.apk'`)), '\n'), (f) => match(f, /\/zapret-[0-9][^\/]*\.apk$/));
		// apk update — чтобы при первой установке подтянулись зависимости (kmod-nft-queue и др.).
		let rc = length(pkgs) ? system(`apk update >/dev/null 2>&1; apk add --allow-untrusted ${join(' ', map(pkgs, shq))}`) : 1;
		system(`rm -rf ${dir}`);
		if (!was_running)
			system('/etc/init.d/zapret stop >/dev/null 2>&1; nft delete table inet zapret 2>/dev/null; nft delete table inet zapret2 2>/dev/null');
		if (!was_enabled)
			system('/etc/init.d/zapret disable >/dev/null 2>&1');
		if (rc != 0) {
			warn(length(pkgs) ? 'apk не установил пакеты zapret\n' : 'в архиве нет пакетов .apk\n');
			return 1;
		}
	}
	else
		return usage();

	// Новые файлы интерфейса и плагина rpcd, новый xray — подхватываем.
	system('rm -rf /tmp/luci-indexcache* /tmp/luci-modulecache; /etc/init.d/rpcd restart; ' +
		(what == 'xray' ? '/etc/init.d/stella restart' : '/etc/init.d/stella reload') + ' >/dev/null 2>&1');
	// Новый бинарник nfqws: гасим наш экземпляр, procd сразу поднимет его заново.
	// (pgrep -f не годится — он находит и саму оболочку с этой строкой.)
	if (what == 'zapret')
		for (let pid in split(trim(cmd_out('pidof nfqws')), ' '))
			if (index(readfile(`/proc/${pid}/cmdline`) || '', `--qnum=${ZAPRET_QNUM}`) >= 0)
				system(`kill ${+pid}`);
	unlink(`${RUN_DIR}/update.json`);
	print('обновлено\n');
	return 0;
}

// Обновление по расписанию. Флаги *.running и логи — те же, что у кнопок в интерфейсе.
function run_locked(name, cmd) {
	if (task_busy(name))
		return false;
	system(`sh ${task_script(name, cmd)} </dev/null`);
	return true;
}

function newest_mtime(pattern) {
	let t = 0;
	for (let f in glob(pattern) || [])
		t = max(t, stat(f)?.mtime ?? 0);
	return t;
}

function cmd_tick() {
	system(`mkdir -p ${RUN_DIR}`);
	let state_path = `${RUN_DIR}/updater.json`;
	let st = read_json(state_path, {});
	let now = time();
	let hour = +trim(cmd_out('date +%H') || '12');
	// Автоподбор Zapret по категориям — ночью (3–5 ч), только если Zapret используется; общая
	// задача ztest — одна проверка за раз.
	let ztest = (scope, key) => ({ name: `ztest_${scope}`, task: 'ztest',
		every: +opt('main', key, '0') * 86400 - 3600,
		since: () => +(read_json(`${ZAPRET_DIR}/results.json`, null)?.at || now),
		when: () => hour >= 3 && hour < 5 && zapret_used(enabled_lists()),
		cmd: `/usr/bin/stella zapret-test ${scope} --apply --scheduled` });
	// Задачи по расписанию: every — период в секундах (0 и меньше — выключена); since — от
	// чего отсчитывать, пока состояния нет (после загрузки); when — дополнительное условие;
	// task — общая блокировка, если не своя.
	let jobs = [
		{ name: 'update', every: +opt('main', 'sub_interval', '12') * 3600,
		  since: () => newest_mtime(`${CACHE_DIR}/*.json`), cmd: '/usr/bin/stella update', reload: true },
		{ name: 'lists', every: +opt('main', 'lists_interval', '24') * 3600,
		  since: () => newest_mtime(`${LISTS_DIR}/*.json`), cmd: '/usr/bin/stella lists', reload: true },
		// Режим «лучший по проверке»; проверка задержки занимает те же порты — тогда позже.
		{ name: 'pick', every: (opt('main', 'select_mode', 'single') == 'best') ? +opt('main', 'best_interval', '6') * 3600 : 0,
		  since: () => stat(STAB_PATH)?.mtime ?? 0, when: () => !task_busy('ping'), cmd: '/usr/bin/stella pick --apply' },
		ztest('main', 'zapret_test_main'),
		ztest('yv', 'zapret_test_yt')
	];
	// После обновлений — reload: init передаёт procd контрольную сумму конфига xray, и тот
	// перезапускается, только если конфиг изменился (например, у узла сменились ключи).
	let reload = false;
	for (let j in jobs) {
		st[j.name] ??= j.since();
		if (j.every > 0 && now - st[j.name] >= j.every && (!j.when || j.when()) && run_locked(j.task || j.name, j.cmd)) {
			st[j.name] = now;
			if (j.reload)
				reload = true;
		}
	}
	writefile(state_path, sprintf('%J', st));

	// Отвязанно: при restart procd останавливает и этот процесс (он — часть службы).
	if (reload && opt('main', 'enabled', '0') == '1')
		system('setsid /etc/init.d/stella reload </dev/null >/dev/null 2>&1 &');
	return 0;
}

function cmd_updater() {
	while (true) {
		sleep(600 * 1000);
		cmd_tick();
	}
}

function cmd_parse(link) {
	let n = parse(link);
	print(sprintf('%.J\n', n));
	return n.error ? 1 : 0;
}


const CMDS = {
	update: cmd_update,
	nodes: cmd_nodes,
	gen: cmd_gen,
	ping: cmd_ping,
	pick: cmd_pick,
	fw: cmd_fw,
	migrate: cmd_migrate,
	lists: cmd_lists,
	tick: cmd_tick,
	'zapret-catalog': cmd_zapret_catalog,
	'zapret-test': cmd_zapret_test,
	'zapret-apply': cmd_zapret_apply,
	upgrade: cmd_upgrade,
	updater: cmd_updater,
	'zapret-cmd': cmd_zapret_cmd,
	parse: (link) => link ? cmd_parse(link) : usage()
};

let cmd = CMDS[ARGV[0]];
exit(cmd ? cmd(...slice(ARGV, 1)) : usage());
