#!/bin/sh
# Событие интерфейса: резервный канал mwan3 (смена узла) или появление/смена DNS провайдера
# после загрузки роутера. Сама команда проверяет, нужно ли перезагружать Stella.

case "$ACTION" in
ifup|ifdown|connected|disconnected) ;;
*) exit 0 ;;
esac
[ "$(uci -q get stella.main.enabled)" = 1 ] || exit 0
[ "$ACTION" = ifup ] || [ -n "$(uci -q get stella.main.backup_iface)" ] || exit 0
/usr/bin/stella uplink >/dev/null 2>&1
