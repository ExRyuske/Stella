#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=10

CONF_DIR=/var/etc/stella
CONF="$CONF_DIR/config.json"
NEW="$CONF_DIR/config.new.json"

start_service() {
	config_load stella
	local enabled
	config_get_bool enabled main enabled 0
	if [ "$enabled" != 1 ]; then
		/usr/bin/stella fw down
		return 0
	fi

	mkdir -p "$CONF_DIR"
	/usr/bin/stella migrate >/dev/null

	# Новый конфиг применяется только если xray его принял; иначе работаем на прежнем.
	# Код 3 — выбранный узел пропал, а замены нет: работающая Stella остаётся на прежнем
	# конфиге, а без него не запускается. Планировщик работает и тогда — обновит подписки,
	# и узел может вернуться.
	local stopped=
	/usr/bin/stella gen "$NEW"
	case $? in
	0)
		if /usr/bin/xray run -test -c "$NEW" >"$CONF_DIR/test.log" 2>&1; then
			mv "$NEW" "$CONF"
		else
			logger -t stella "новый конфиг отклонён (см. $CONF_DIR/test.log), остаётся прежний"
			rm -f "$NEW"
		fi
		;;
	3)
		rm -f "$NEW"
		if [ -f "$CONF" ]; then
			logger -t stella "выбранный узел пропал, замены нет — остаётся прежний конфиг"
		else
			logger -t stella "выбранный узел пропал, замены нет — Stella не запущена до его возвращения"
			stopped=1
		fi
		;;
	*)
		logger -t stella "не удалось собрать конфиг, остаётся прежний"
		rm -f "$NEW"
		;;
	esac
	if [ -z "$stopped" ] && [ ! -f "$CONF" ]; then
		/usr/bin/stella fw down
		return 1
	fi

	[ -n "$stopped" ] || start_traffic
	start_updater

	if [ -n "$stopped" ]; then
		/usr/bin/stella fw down
	else
		/usr/bin/stella fw up
	fi
}

start_traffic() {
	procd_open_instance
	procd_set_param command /usr/bin/xray run -c "$CONF"
	# Контрольная сумма конфига: при reload procd перезапустит xray, только если конфиг
	# действительно изменился (узел, ключи после обновления подписки, DNS…), и не тронет
	# соединения, если поменялись одни списки.
	# GOMEMLIMIT — мягкий предел памяти для Go (треть ОЗУ): без него xray держит память с
	# большим запасом, и на роутере со 128–256 МБ до нехватки памяти недалеко.
	local mem_kb
	mem_kb=$(awk '/^MemTotal:/ { print $2 }' /proc/meminfo)
	procd_set_param env STELLA_CONF_SUM="$(md5sum <"$CONF" | cut -d' ' -f1)" \
		${mem_kb:+GOMEMLIMIT=$((mem_kb / 3 / 1024))MiB}
	procd_set_param respawn 3600 5 0
	procd_set_param limits nofile="65535 65535"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	# nfqws — только если где-то выбрано действие «Zapret».
	local arg
	if /usr/bin/stella zapret-cmd >"$CONF_DIR/nfqws.args"; then
		procd_open_instance nfqws
		{
			IFS= read -r arg
			procd_set_param command "$arg"
			while IFS= read -r arg; do
				procd_append_param command "$arg"
			done
		} <"$CONF_DIR/nfqws.args"
		procd_set_param respawn 3600 5 0
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	fi
}

# Обновление подписок и списков, подбор узла и ночной автоподбор Zapret по расписанию.
start_updater() {
	local sub_h lists_h zt_days mode
	config_get sub_h main sub_interval 12
	config_get lists_h main lists_interval 24
	config_get zt_days main zapret_test_interval 0
	config_get mode main select_mode single
	if [ "$sub_h" != 0 ] || [ "$lists_h" != 0 ] || [ "$zt_days" != 0 ] || [ "$mode" = best ]; then
		procd_open_instance updater
		procd_set_param command /usr/bin/stella updater
		procd_set_param respawn 3600 5 0
		procd_set_param stderr 1
		procd_close_instance
	fi
}

stop_service() {
	# При restart правила остаются: start_service тут же применит их заново,
	# а снятие стоило бы лишнего перезапуска dnsmasq.
	[ "$action" = restart ] || /usr/bin/stella fw down
}

service_triggers() {
	procd_add_reload_trigger stella
}
